{
  "name": "basexor-jmk",
  "version": "1.0.0",
  "description": "BaseXOR symmetric encryption pool paid tag authentication system",
  "private": true,
  "workspaces": [
    "backend/shared",
    "backend/server",
    "backend/shop",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:shop\"",
    "dev:server": "npm --prefix backend/server run dev",
    "dev:shop": "npm --prefix backend/shop run dev",
    "build": "npm run build:shared && npm run build:server && npm run build:shop && npm run build:frontend",
    "build:shared": "npm --prefix backend/shared run build",
    "build:server": "npm --prefix backend/server run build",
    "build:shop": "npm --prefix backend/shop run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "concurrently \"npm run start:server\" \"npm run start:shop\"",
    "start:server": "npm --prefix backend/server start",
    "start:shop": "npm --prefix backend/shop start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
