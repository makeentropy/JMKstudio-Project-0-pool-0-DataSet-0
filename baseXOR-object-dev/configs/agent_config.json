{
    "agent": {
        "name": "baseXOR_AI_Agent",
        "version": "1.0.0",
        "mode": "LLM_POOL",
        "dataset": "dataset-kali_linux",
        "llm_provider": "ollama",
        "model": "llama2",
        "nlp_enabled": true,
        "quantum_mode": true
    },
    "server": {
        "cpu": {
            "boost_enabled": true,
            "cores": "all",
            "priority": "high"
        },
        "gpu": {
            "enabled": true,
            "cuda_enabled": true,
            "memory_allocation": "auto"
        },
        "nlp": {
            "enabled": true,
            "pipeline": "transformers",
            "models": ["bert", "llama2", "mistral"]
        },
        "disk": {
            "acceleration": true,
            "pool_path": "/pools",
            "cache_enabled": true
        }
    },
    "ai": {
        "llm": {
            "provider": "ollama",
            "endpoint": "http://localhost:11434",
            "models": ["llama2", "codellama", "mistral"]
        },
        "agent": {
            "autonomous": true,
            "tools": ["docker", "file_ops", "network", "compute"],
            "max_iterations": 100
        }
    },
    "capabilities": {
        "cpu_boost": true,
        "gpu_boost": true,
        "nlp_processing": true,
        "disk_acceleration": true,
        "memory_matrix": true,
        "quantum_addressing": true
    }
}
