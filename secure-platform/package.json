{
  "name": "secure-platform",
  "version": "1.0.0",
  "description": "Secure platform with encryption, certificate verification, payment integration and blockchain notarization",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node backend/src/index.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=\"tests/unit\"",
    "test:integration": "jest --testPathPattern=\"tests/integration\"",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "alipay-sdk": "^3.4.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  }
}
