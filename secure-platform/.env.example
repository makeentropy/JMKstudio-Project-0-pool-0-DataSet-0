PORT=3000
NODE_ENV=development

# Session / JWT Security
SESSION_SECRET=your-session-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-key-here-change-in-production
SESSION_TTL_SECONDS=86400
JWT_EXPIRES_IN=24h

# Redis Session Store (optional, leave empty for in-memory)
REDIS_URL=

# Alipay Configuration (沙箱环境默认)
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYourAlipayPrivateKeyHere\n-----END RSA PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYourAlipayPublicKeyHere\n-----END PUBLIC KEY-----
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/api/payment/alipay/return
# 沙箱: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
