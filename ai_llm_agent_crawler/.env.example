# AI LLM Agent Crawler 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# 应用配置
APP_NAME=ai_llm_agent_crawler
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/ai_llm_agent_crawler.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# 爬虫配置
CRAWLER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3
CRAWLER_DELAY=1.0
CRAWLER_CONCURRENT_REQUESTS=10

# 数据库配置（示例）
DATABASE_URL=postgresql://user:password@localhost:5432/ai_crawler
DATABASE_POOL_SIZE=10

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# MongoDB配置（示例）
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ai_crawler

# Elasticsearch配置（示例）
ELASTICSEARCH_URL=http://localhost:9200

# MinIO配置（示例）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=ai-crawler

# AWS S3配置（示例）
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket

# 安全加密配置
ENCRYPTION_KEY=your_encryption_key_here
HASH_ALGORITHM=SHA-256

# 数据集配置
DATASET_OUTPUT_DIR=data/datasets
DATASET_FORMAT=parquet

# 存储配置
STORAGE_NAS_PATH=/mnt/nas
STORAGE_MAX_SIZE=107374182400